@startuml

class Company {
    - _id: int
    - _name: String
    --
    # Company(name: String)
    + getId(): int
    + getSellPrice(inventory: Inventory): Product[]
}
Company "1" -- "0..*" Inventory
Company "1" -- "0..*" Basket
Purchase "*" --> "1" Company
Erp "1" --> "*" Company


class Inventory {
    - _availableUnits: int
    - _multipliedFactor: double
    --
    # Inventory(availableUnits: int, multipliedFactor: double)
    + changeInventory(num: int, newFactor: double): boolean
}
Company "1" -- "0..*" Inventory
Product "1" -- "0..*" Inventory


class Client {
    /' - _mechanism: NotificationMechanism '/
    - _name: String
    - _email: String
    --
    # Client(name: String, email: String)
    + getName(): String
    + notify(not: Notification)
}
Client "1" -- "0..*" Basket
Client "*" --> "1" NotificationMechanism
Client ..> Notification
Purchase "*" --> "1" Client
Erp "1" --> "*" Client


@enduml
